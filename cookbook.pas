var
  Line: AnsiString;
  N: Integer;
  Got: Boolean;

function ReadLine: Boolean;
begin
  Result := False;
  if not Eof(Input) then
  begin
    ReadLn(Line);
    Line := Trim(Line);
    Result := True;
  end;
end;

function Parse(const S: AnsiString): Integer;
var
  I, K, Acc: Integer;
begin
  K := Length(S);
  if (K < 1) or (K > 3) then begin Parse := -1; Exit; end;
  Acc := 0;
  for I := 1 to K do
  begin
    if (S[I] < '0') or (S[I] > '9') then begin Parse := -1; Exit; end;
    Acc := Acc * 10 + (Ord(S[I]) - Ord('0'));
  end;
  Parse := Acc;
end;

begin
  repeat
    Write(MENU);
    Got := ReadLine;
    if not Got then
    begin
      Write(MSG_BYE);
      Break;
    end;
    N := Parse(Line);
    if N = -1 then Write(MSG_BAD)
    else if N = 0 then
    begin
      Write(MSG_BYE);
      Break;
    end
    else if N > LAST then Write(MSG_BAD)
    else
    begin
      Write(RECIPES[N]);
      Write(MSG_PAUSE);
      if not ReadLine then
      begin
        Write(MSG_BYE);
        Break;
      end;
    end;
  until False;
end.
