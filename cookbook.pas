  '' + #10 + '### 44. ПЕРЕЦ ФАРШИРОВАННЫЙ с мясом и рисом (6 порций)' + #10 + 'Ингредиенты:' + #10 + '  перец болгарский 6 шт, фарш 500 г, рис 80 г,' + #10 + '  морковь 1 шт, лук 1 шт, томатная паста 2 ст.л.,' + #10 + '  сметана 150 г, соль-перец.' + #10 + 'Приготовление:' + #10 + '  1. Рис отварить до полуготовности.' + #10 + '  2. Лук и морковь нарезать мелко, смешать с фаршем и рисом.' + #10 + '  3. Наполнить перцы, накрыть срезанными крышечками.' + #10 + '  4. Уложить в форму, добавить пасту и немного воды.' + #10 + '  5. Тушить при 180 градусах 45 мин.' + #10 + '  6. Подавать со сметаной.' + #10 + '',
  '' + #10 + '### 45. БАКЛАЖАНЫ ФАРШИРОВАННЫЕ (4 порции)' + #10 + 'Ингредиенты:' + #10 + '  баклажаны 4 шт, фарш 400 г, лук 1 шт, морковь 1 шт,' + #10 + '  чеснок 3 зубчика, сыр 100 г, томатная паста 2 ст.л.,' + #10 + '  соль-перец.' + #10 + 'Приготовление:' + #10 + '  1. Баклажаны разрезать пополам, вырезать мякоть.' + #10 + '  2. Мякоть нарезать и обжарить с луком и морковью.' + #10 + '  3. Смешать с фаршем, чесноком, пастой и сыром.' + #10 + '  4. Наполнить половинки баклажанов.' + #10 + '  5. Запекать при 190 градусах 35-40 мин.' + #10 + '',
  '' + #10 + '### 46. ПЛОВ узбекский с говядиной (6 порций)' + #10 + 'Ингредиенты:' + #10 + '  говядина 700 г, рис 500 г, морковь 3 шт,' + #10 + '  лук 2 шт, чеснок 1 головка, масло 100 мл,' + #10 + '  зира 1 ст.л., барбарис, перец, соль.' + #10 + 'Приготовление:' + #10 + '  1. Мясо нарезать крупными кусками, отварить 40 мин в полуготовности.' + #10 + '  2. Лук и морковь нарезать брусочком, отдельно обжарить до золота.' + #10 + '  3. Собрать плов в казане слоями: масло, мясо, овощи, рис, специи.' + #10 + '  4. Залить горячей водой на 1 см выше риса, не мешать.' + #10 + '  5. Довести до кипения и перевести на самый слабый огонь.' + #10 + '  6. Чеснок втыкать в рис сверху, варить 45 мин до впитывания.' + #10 + '  7. Собрать горкой и дать настояться 20 мин.' + #10 + '',
