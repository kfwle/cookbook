48. Бефстроганов     73. Запеканка        98. Брауни\n   24. Лапша            49. Говядина туш.    74. Картофель фри    99. Тарт клубника\n   25. Бульон куриный   50. Стейк            75. Драники         100. Творожный дес.\n> ")
(define msg-bad "\n[!] Нет такого рецепта. Введи число от 1 до 100 или 0 для выхода.\n")
(define msg-pause "\n--- Нажми Enter, чтобы вернуться в меню ---\n")
(define msg-bye "\nПриятного аппетита!\n")

;; #f на конце потока
(define (read-stdin-line)
  (let ((l (read-line (current-input-port))))
    (if (eof-object? l) #f (string-trim l))))

(define (all-digits? cs)
  (cond ((null? cs) #t)
        ((let ((k (char->integer (car cs))))
           (and (>= k 48) (<= k 57)))
         (all-digits? (cdr cs)))
        (else #f)))

(define (parse s)
  (if (and (> (string-length s) 0)
           (<= (string-length s) 3)
           (all-digits? (string->list s)))
      (string->number s)
      #f))


(define (loop)
  (display menu)
  (let ((s (read-stdin-line)))
    (cond
     ((not s) (display msg-bye))
     (else
      (let ((n (parse s)))
        (cond
         ((not n) (display msg-bad) (loop))
         ((= n 0) (display msg-bye))
         ((> n last) (display msg-bad) (loop))
         (else (display (list-ref recipes (1- n)))
               (display msg-pause)
               (if (read-stdin-line) (loop) (display msg-bye)))))))))

(loop)
